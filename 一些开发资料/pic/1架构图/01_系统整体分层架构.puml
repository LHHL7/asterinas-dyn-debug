@startuml 系统整体分层架构
' ============================================================
' 图1: Asterinas Dynamic Debug 系统整体分层架构
' 5层: 宏层 → 静态注册层 → 修补层/过滤引擎 → 接口层
' ============================================================

skinparam backgroundColor #FEFEFE
skinparam defaultFontName "WenQuanYi Micro Hei"

skinparam package {
  BackgroundColor<<compile>> #E8F5E9
  BorderColor<<compile>> #4CAF50
  BackgroundColor<<runtime>> #E3F2FD
  BorderColor<<runtime>> #2196F3
  FontSize 14
}

skinparam rectangle {
  FontSize 12
}

skinparam arrow {
  Color #546E7A
  Thickness 2
  FontSize 12
}

title Asterinas Dynamic Debug 系统整体分层架构

' ==================================================================
' 上半部分: 运行时引擎
' ==================================================================
package "【运行时引擎】" as RUNTIME <<runtime>> {

  package "用户接口层" as IFACE #F3E5F5 {
    rectangle "规则管理\n控制 dyndbg 启用/禁用" as dd
    rectangle "性能基准\n触发压测并收集结果" as bench
    rectangle "统计观测\n暴露内部运行指标" as stats
  }

  package "运行时过滤引擎" as FILTER #FCE4EC {
    rectangle "规则链\n规则匹配与冲突裁决" as rules
    rectangle "多维索引\n加速候选描述符查找" as index
    rectangle "模块级门控\n快速跳过禁用模块" as modstate
    rectangle "增量重算\n仅重算受影响的站点" as refresh
  }

  package "静态指令修补层" as PATCH #FFF3E0 {
    rectangle "指令槽管理\n运行时替换 NOP ↔ JMP" as slot
    rectangle "SMP 安全\n多核并发修补同步" as smp
  }

  IFACE -down-> FILTER : "规则读写"
  FILTER -down-> PATCH : "触发修补"
}

' ==================================================================
' 下半部分: 编译时基础设施
' ==================================================================
package "【编译时基础设施】" as COMPILE <<compile>> {

  package "静态注册层" as REGISTRY #E3F2FD {
    rectangle "描述符注册表\n所有调用点的元数据集合" as desc_reg
    rectangle "站点注册表\n指令地址与跳转目标集合" as site_reg
  }

  package "宏层" as MACRO #E8F5E9 {
    rectangle "调用点宏\n为每个调试调用生成站点" as macros
    rectangle "后端选择\n静态修补 / 软件分支" as backends
  }

  MACRO -up-> REGISTRY : "编译时分散定义\n链接时合并为静态切片"
}

' ==================================================================
' 注册层 → 运行时的启动时绑定
' ==================================================================
REGISTRY -up-> FILTER : "启动时\n构建索引"
REGISTRY -up-> PATCH : "启动时\n构建模块视图"

@enduml
